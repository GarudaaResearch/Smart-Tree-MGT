# ============================================================
# TreeSense AI — Environment Configuration Template
# Copy this file to .env and fill in your values
# ============================================================

# ─── Application ─────────────────────────────────────────
APP_NAME=TreeSense AI
APP_VERSION=1.0.0
ENVIRONMENT=development          # development | production
DEBUG=true
LOG_LEVEL=info

# ─── API Security ────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-64-char-secret-key-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ─── Database (PostgreSQL + PostGIS) ─────────────────────
DATABASE_URL=postgresql+asyncpg://treesense:treesense_secret_2026@localhost:5432/treesense_ai
POSTGRES_DB=treesense_ai
POSTGRES_USER=treesense
POSTGRES_PASSWORD=treesense_secret_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SQL_ECHO=false

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_DB=0
CACHE_TTL_SECONDS=300

# ─── MQTT Broker (Mosquitto) ─────────────────────────────
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_USERNAME=treesense_node
MQTT_PASSWORD=node_secret_2026
MQTT_KEEPALIVE=60
MQTT_QOS=1

# ─── LoRa Gateway ────────────────────────────────────────
LORA_GATEWAY_ID=GW-RGU-001
LORA_NETWORK_ID=0x13

# ─── AI Model Settings ────────────────────────────────────
MODEL_STORE_PATH=./app/models_store
AI_CONFIDENCE_THRESHOLD=0.75
ANOMALY_SCORE_THRESHOLD=0.65
DISEASE_RISK_THRESHOLD=0.50
HEALTH_CRITICAL_THRESHOLD=30
HEALTH_WARNING_THRESHOLD=50

# ─── AWS (optional cloud storage) ────────────────────────
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=treesense-ai-data
AWS_IOT_ENDPOINT=your-iot-endpoint.iot.ap-south-1.amazonaws.com

# ─── GIS / Mapping ───────────────────────────────────────
DEFAULT_MAP_CENTER_LAT=11.0168
DEFAULT_MAP_CENTER_LNG=76.9558
DEFAULT_MAP_ZOOM=14

# ─── Notifications ───────────────────────────────────────
# Twilio (SMS)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
ALERT_PHONE_NUMBER=+91XXXXXXXXXX

# SendGrid (Email)
SENDGRID_API_KEY=your-sendgrid-key
ALERT_EMAIL_FROM=treesense@rgu.ac.in
ALERT_EMAIL_TO=admin@rgu.ac.in

# Firebase (Mobile Push)
FIREBASE_CREDENTIALS_PATH=./deployment/firebase-credentials.json

# ─── Monitoring ──────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090

# ─── CORS ────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost,http://localhost:3001,https://treesense.rgu.ac.in

# ─── Rate Limiting ───────────────────────────────────────
SENSOR_INGEST_RATE_LIMIT=1000/minute
API_RATE_LIMIT=300/minute
AI_RATE_LIMIT=60/minute
